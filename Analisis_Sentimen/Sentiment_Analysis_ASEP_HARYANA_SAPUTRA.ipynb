    "# Re-implement basic cleaning for inference to match the pipeline\n",
    "def clean_text_inference(text):\n",
    "    text = str(text)\n",
    "    text = re.sub(r'https?://\\S+|www\\.\\S+', '', text)\n",
    "    text = re.sub(r'@\\w+', '', text)\n",
    "    text = ' '.join(text.split())\n",
    "    text = re.sub(r'[^\\w\\s\\u00C0-\\u017F]', ' ', text)\n",
    "    return text.strip()\n",
    "\n",
    "def predict_sentiment(text_list):\n",
    "    # Preprocess\n",
    "    cleaned_texts = [clean_text_inference(t) for t in text_list]\n",
    "    sequences = tokenizer.texts_to_sequences(cleaned_texts)\n",
    "    padded = pad_sequences(sequences, maxlen=MAX_LENGTH, padding='post', truncating='post')\n",
    "    \n",
    "    # Predict\n",
    "    probs = best_model.predict(padded)\n",
    "    preds = np.argmax(probs, axis=1)\n",
    "    \n",
    "    labels = {0: 'Negative', 1: 'Positive', 2: 'Spam'}\n",
    "    results = []\n",
    "    for t, p in zip(text_list, preds):\n",
    "        results.append({'Text': t, 'Prediction': labels[p]})\n",
    "    \n",
    "    return pd.DataFrame(results)\n",
    "\n",
    "# Test Cases\n",
    "test_sentences = [\n",
    "    \"Video ini sangat bermanfaat, terima kasih bang!\",\n",
    "    \"Konten sampah, tidak mendidik sama sekali.\",\n",
    "    \"Cek ig kami kak, ada promo menarik.\",\n",
    "    \"Biasa saja sih, tidak ada yang spesial.\",\n",
    "    \"Gajelas lu bang, unsub ah.\",\n",
    "    \"Haha,keren\"\n",
    "]\n",
    "\n",
    "inference_results = predict_sentiment(test_sentences)\n",
    "print(inference_results)"
   ]
