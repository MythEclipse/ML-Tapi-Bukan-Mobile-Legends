   "source": [
    "\"\"\"\n",
    "Data Preprocessing and Auto-Labeling Module for YouTube Comments Analysis\n",
    "Optimized for specific dataset structure\n",
    "\"\"\"\n",
    "\n",
    "class YouTubeCommentsPreprocessor:\n",
    "    \"\"\"Preprocessing and auto-labeling pipeline for YouTube comments dataset.\"\"\"\n",
    "    \n",
    "    def __init__(self, filepath: str, random_seed: int = 42):\n",
    "        \"\"\"\n",
    "        Initialize preprocessor with dataset filepath.\n",
    "        \n",
    "        Parameters:\n",
    "        -----------\n",
    "        filepath : str\n",
    "            Path to the CSV dataset file\n",
    "        random_seed : int\n",
    "            Random seed for reproducibility\n",
    "        \"\"\"\n",
    "        self.filepath = filepath\n",
    "        self.random_seed = random_seed\n",
    "        self.df = None\n",
    "        self.labeled_data = None\n",
    "        \n",
    "        # Define keyword dictionaries for auto-labeling (optimized based on sample data)\n",
    "        self.spam_keywords = [\n",
    "            'jual', 'obat', 'promo', 'subscribe', 'sub4sub', 'mampir', 'channel',\n",
    "            'link bio', 'giveaway', 'hadiah', 'gratis', 'follow', 'visit', 'klik',\n",
    "            'top up', 'jasa', 'bisnis', 'wa', '08', 'judol', 'slot', 'gacor',\n",
    "            'saweria', 'donasi', 'kunjungi', 'order', 'murah', 'diskon', 'free',\n",
    "            'uang', 'req', 'request', 'sir', 'bang', 'req', 'request', 'fadli',\n",
    "            'ritz', 'kalo', 'kapan', 'upload', 'lagi', 'trailer', 'kocak'\n",
    "        ]\n",
    "        \n",
    "        self.positive_keywords = [\n",
    "            'bagus', 'keren', 'mantap', 'semangat', 'good', 'nice', 'love', 'thanks',\n",
    "            'terima kasih', 'bermanfaat', 'membantu', 'suka', 'cool', 'best', 'hebat',\n",
    "            'lanjutkan', 'panutan', 'idol', 'legend', 'terhibur', 'lucu', 'ngakak',\n",
    "            'kocak', 'anjay', 'gokil', 'pecah', 'trending', 'karyamu', 'support', 'wow',\n",
    "            'gas', 'menyala', 'respect', 'salut', 'kualitas', 'setuju', 'bantu',\n",
    "            'inspiration', 'edukasi', 'top', 'amazing', 'keren', 'gokil', 'menyala',\n",
    "            'wow', 'gas', 'semangat', 'respect', 'nice', 'good', 'cool', 'best', 'love',\n",
    "            'lucu', 'ngakak', 'terhibur', 'gokil', 'kocak', 'anjay', 'mantap', 'keren',\n",
    "            'bagus', 'kangen', 'kangen masa-masa', 'masih tetep lucu', 'anjay bang',\n",
    "            'anjayyy', 'anjay wkwk', 'anjay keren bang'\n",
    "        ]\n",
    "        \n",
    "        self.negative_keywords = [\n",
    "            'jelek', 'buruk', 'sampah', 'gagal', 'benci', 'hate', 'bad', 'stupid',\n",
    "            'idiot', 'bodoh', 'gajelas', 'malas', 'susah', 'ribet', 'unsub', 'cringe',\n",
    "            'alay', 'lebay', 'norak', 'garing', 'toxic', 'kontol', 'memek', 'anjing',\n",
    "            'bangsat', 'tolol', 'goblok', 'hujat', 'drama', 'settingan', 'sampah',\n",
    "            'kecewa', 'merugikan', 'penipu', 'bohong', 'palsu', 'hoax', 'fitnah',\n",
    "            'biadab', 'najis', 'haram', 'dosa', 'sesat', 'babi', 'cringe', 'norak',\n",
    "            'gajelas', 'garing', 'lebay', 'alay', 'toxic', 'bangsat', 'tolol', 'goblok',\n",
    "            'hate', 'benci', 'sampah', 'jelek', 'buruk', 'bodoh', 'stupid', 'idiot',\n",
    "            'penipu', 'bohong', 'palsu', 'hoax', 'fitnah', 'dosa', 'haram'\n",
    "        ]\n",
    "        \n",
    "        # Special patterns for spam detection\n",
    "        self.spam_patterns = [\n",
    "            r'https?://\\S+',  # URLs\n",
    "            r'@\\w+',  # Mentions (in comments)\n",
    "            r'\\d{10,}',  # Phone numbers\n",
    "            r'\\b(?:odading|odin)\\d*\\w*\\b',  # Gambling references\n",
    "            r'#[A-Za-z0-9_]+',  # Hashtags in large quantities\n",
    "            r'[A-Z]{4,}',  # Excessive caps\n",
    "            r'\\b(?:cek|visit|follow|sub)\\s*(?:ig|instagram|channel)\\b',\n",
    "        ]\n",
    "        \n",
    "        # Label mapping\n",
    "        self.label_map = {\n",
    "            0: 'negative',\n",
    "            1: 'positive',\n",
    "            2: 'spam',\n",
    "            -1: 'unlabeled'\n",
    "        }\n",
    "    \n",
    "    def load_dataset(self) -> pd.DataFrame:\n",
    "        \"\"\"\n",
    "        Load dataset from CSV file.\n",
    "        \"\"\"\n",
    "        if not os.path.exists(self.filepath):\n",
    "            raise FileNotFoundError(\n",
    "                f\"Dataset file not found at: {self.filepath}\\n\"\n",
    "                \"Please ensure the scraping script has been executed.\"\n",
    "            )\n",
    "        \n",
    "        self.df = pd.read_csv(self.filepath)\n",
    "        print(f\"[INFO] Loaded {len(self.df):,} rows from {self.filepath}\")\n",
    "        # print(f\"[INFO] Columns: {', '.join(self.df.columns)}\")\n",
    "        return self.df\n",
    "    \n",
    "    def filter_columns(self) -> pd.DataFrame:\n",
    "        \"\"\"\n",
    "        Select relevant columns for analysis.\n",
    "        Based on the sample data: 'cid', 'text', 'time', 'author', 'votes', 'photo', 'heart'\n",
    "        We keep: 'text', 'votes', 'heart'\n",
    "        \"\"\"\n",
    "        # Keep only essential columns for analysis\n",
    "        keep_columns = ['text', 'votes', 'heart']\n",
    "        \n",
    "        # Check if required columns exist\n",
    "        missing_cols = [col for col in keep_columns if col not in self.df.columns]\n",
    "        if missing_cols:\n",
    "            raise ValueError(f\"Missing required columns: {missing_cols}\")\n",
    "        \n",
    "        # Preserve existing labels if present\n",
    "        if 'label' in self.df.columns:\n",
    "            keep_columns.append('label')\n",
    "            print(\"[INFO] Existing labels detected in dataset\")\n",
    "        \n",
    "        # Create filtered copy\n",
    "        self.df = self.df[keep_columns].copy()\n",
    "        # print(f\"[INFO] Selected columns: {', '.join(self.df.columns)}\")\n",
    "        \n",
    "        return self.df\n",
    "    \n",
    "    @staticmethod\n",
    "    def clean_vote_count(vote_str: str) -> float:\n",
    "        \"\"\"\n",
    "        Convert vote count string to numeric value.\n",
    "        Handles formats like '10 rb' (Indonesian), '1.2K', '5M', '1,234'.\n",
    "        \"\"\"\n",
    "        if pd.isna(vote_str) or vote_str == '':\n",
    "            return 0.0\n",
    "        \n",
    "        vote_str = str(vote_str).strip().lower()\n",
    "        \n",
    "        # Handle Indonesian notation 'rb' (ribu)\n",
    "        if 'rb' in vote_str:\n",
    "            multiplier = 1000\n",
    "            vote_str = vote_str.replace('rb', '').replace(' ', '') \n",
    "        # Handle 'K' (thousands) and 'M' (millions) notation\n",
    "        elif 'k' in vote_str:\n",
    "            multiplier = 1000\n",
    "            vote_str = vote_str.replace('k', '')\n",
    "        elif 'm' in vote_str:\n",
    "            multiplier = 1_000_000\n",
    "            vote_str = vote_str.replace('m', '')\n",
    "        else:\n",
    "            multiplier = 1\n",
    "        \n",
    "        # Remove commas and non-breaking spaces\n",
    "        vote_str = vote_str.replace(',', '').replace(' ', '')\n",
    "        \n",
    "        # Extract numeric value\n",
    "        numeric_match = re.search(r'[\\d.]+', vote_str)\n",
    "        if numeric_match:\n",
    "            try:\n",
    "                return float(numeric_match.group()) * multiplier\n",
    "            except (ValueError, TypeError):\n",
    "                return 0.0\n",
    "        return 0.0\n",
    "    \n",
    "    def standardize_heart_reaction(self) -> pd.DataFrame:\n",
    "        \"\"\"\n",
    "        Standardize heart reaction column to binary values.\n",
    "        \"\"\"\n",
    "        # Create comprehensive mapping\n",
    "        heart_mapping = {\n",
    "            'true': 1, 'false': 0, '1': 1, '0': 0,\n",
    "            'yes': 1, 'no': 0, 'y': 1, 'n': 0,\n",
    "            't': 1, 'f': 0, 'true': 1, 'false': 0\n",
    "        }\n",
    "        \n",
    "        # Convert to string, lowercase, map, fill NaN with 0\n",
    "        self.df['heart'] = (\n",
    "            self.df['heart']\n",
    "            .astype(str)\n",
    "            .str.strip()\n",
    "            .str.lower()\n",
    "            .map(heart_mapping)\n",
    "            .fillna(0)\n",
    "            .astype(int)\n",
    "        )\n",
    "        \n",
    "        heart_count = self.df['heart'].sum()\n",
    "        heart_percentage = (heart_count / len(self.df)) * 100\n",
    "        print(f\"[INFO] Heart reactions standardized: {heart_count:,} positive reactions ({heart_percentage:.1f}%)\")\n",
    "        \n",
    "        return self.df\n",
    "    \n",
    "    def _contains_spam_pattern(self, text: str) -> bool:\n",
    "        \"\"\"\n",
    "        Check if text contains spam patterns.\n",
    "        \"\"\"\n",
    "        text_lower = str(text).lower()\n",
    "        \n",
    "        # Check for spam patterns using regex\n",
    "        for pattern in self.spam_patterns:\n",
    "            if re.search(pattern, text_lower, re.IGNORECASE):\n",
    "                return True\n",
    "        \n",
    "        return False\n",
    "    \n",
    "    def auto_label_comments(self, use_existing: bool = True) -> pd.DataFrame:\n",
    "        \"\"\"\n",
    "        Apply heuristic-based auto-labeling to unlabeled comments.\n",
    "        \"\"\"\n",
    "        print(\"[INFO] Applying heuristic auto-labeling...\")\n",
    "        \n",
    "        def assign_label(comment: str) -> int:\n",
    "            \"\"\"Assign label based on keyword matching.\"\"\"\n",
    "            if pd.isna(comment) or comment == '':\n",
    "                return -1\n",
    "                \n",
    "            comment_lower = str(comment).lower()\n",
    "            \n",
    "            # Priority 1: Spam detection\n",
    "            if self._contains_spam_pattern(comment_lower):\n",
    "                return 2  # Spam\n",
    "            \n",
    "            # Check spam keywords\n",
    "            if any(keyword in comment_lower for keyword in self.spam_keywords):\n",
    "                return 2  # Spam\n",
    "            \n",
    "            # Priority 2: Positive sentiment\n",
    "            if any(keyword in comment_lower for keyword in self.positive_keywords):\n",
    "                return 1  # Positive\n",
    "            \n",
    "            # Priority 3: Negative sentiment\n",
    "            if any(keyword in comment_lower for keyword in self.negative_keywords):\n",
    "                return 0  # Negative\n",
    "            \n",
    "            # Check for very short comments (likely spam/uninformative)\n",
    "            if len(comment_lower.strip()) < 10:\n",
    "                return 2  # Spam\n",
    "            \n",
    "            return -1  # Unclassified\n",
    "        \n",
    "        # Check if we should use existing labels\n",
    "        # NOTE: For this project, we prefer re-labeling to ensure consistency with new keywords, \n",
    "        # unless user explicitly wants to keep old ones. Setting use_existing=False by default for strictness,\n",
    "        # but function argument allows flexibility.\n",
    "        if use_existing and 'label' in self.df.columns and self.df['label'].isin([0, 1, 2]).all():\n",
    "             print(\"[INFO] Using existing labels from dataset\")\n",
    "             self.df['label'] = self.df['label'].astype(int)\n",
    "        else:\n",
    "            # Apply auto-labeling\n",
    "            self.df['label'] = self.df['text'].apply(assign_label)\n",
    "        \n",
    "        # Calculate labeling statistics\n",
    "        label_counts = self.df['label'].value_counts()\n",
    "        total_comments = len(self.df)\n",
    "        labeled_count = total_comments - label_counts.get(-1, 0)\n",
    "        labeled_pct = (labeled_count / total_comments) * 100\n",
    "        \n",
    "        print(f\"[INFO] Auto-labeling completed: {labeled_pct:.1f}% of comments classified\")\n",
    "        for label_val in sorted(label_counts.index):\n",
    "            count = label_counts[label_val]\n",
    "            label_name = self.label_map.get(label_val, f'unknown ({label_val})')\n",
    "            percentage = (count / total_comments) * 100\n",
    "            print(f\"       {label_name.capitalize():<12}: {count:>6,} comments ({percentage:5.1f}%)\")\n",
    "        \n",
    "        return self.df\n",
    "    \n",
    "    def remove_unlabeled_comments(self) -> pd.DataFrame:\n",
    "        \"\"\"\n",
    "        Filter out unlabeled comments (label = -1).\n",
    "        \"\"\"\n",
    "        if 'label' not in self.df.columns:\n",
    "            raise ValueError(\"No label column found. Run auto_label_comments() first.\")\n",
    "        \n",
    "        initial_count = len(self.df)\n",
    "        self.labeled_data = self.df[self.df['label'] != -1].copy()\n",
    "        \n",
    "        removed_count = initial_count - len(self.labeled_data)\n",
    "        # print(f\"[INFO] Removed {removed_count:,} unlabeled comments\")\n",
    "        print(f\"[INFO] Retained {len(self.labeled_data):,} labeled comments\")\n",
    "        \n",
    "        return self.labeled_data\n",
    "    \n",
    "    def balance_dataset(self, strategy: str = 'upsample', min_samples: int = None) -> pd.DataFrame:\n",
    "        \"\"\"\n",
    "        Balance dataset using specified strategy.\n",
    "        \"\"\"\n",
    "        if self.labeled_data is None:\n",
    "            raise ValueError(\"No labeled data available. Run remove_unlabeled_comments() first.\")\n",
    "        \n",
    "        # Split by class\n",
    "        df_positive = self.labeled_data[self.labeled_data['label'] == 1]\n",
    "        df_negative = self.labeled_data[self.labeled_data['label'] == 0]\n",
    "        df_spam = self.labeled_data[self.labeled_data['label'] == 2]\n",
    "        \n",
    "        # print(f\"\\n[INFO] Class distribution before balancing:\")\n",
    "        # for label_val, df_class in [(1, df_positive), (0, df_negative), (2, df_spam)]:\n",
    "        #     label_name = self.label_map.get(label_val, 'unknown')\n",
    "        #     print(f\"       {label_name.capitalize():<12}: {len(df_class):>6,} samples\")\n",
    "        \n",
    "        if strategy == 'upsample':\n",
    "            # Determine target sample size\n",
    "            if min_samples is not None:\n",
    "                target_samples = min_samples\n",
    "            else:\n",
    "                target_samples = max(len(df_positive), len(df_negative), len(df_spam))\n",
    "            \n",
    "            # Apply upsampling with replacement\n",
    "            df_positive_upsampled = resample(\n",
    "                df_positive,\n",
    "                replace=True,\n",
    "                n_samples=target_samples,\n",
    "                random_state=self.random_seed\n",
    "            )\n",
    "            \n",
    "            df_negative_upsampled = resample(\n",
    "                df_negative,\n",
    "                replace=True,\n",
    "                n_samples=target_samples,\n",
    "                random_state=self.random_seed\n",
    "            )\n",
    "            \n",
    "            df_spam_upsampled = resample(\n",
    "                df_spam,\n",
    "                replace=True,\n",
    "                n_samples=target_samples,\n",
    "                random_state=self.random_seed\n",
    "            )\n",
    "            \n",
    "            # Combine balanced datasets\n",
    "            self.labeled_data = pd.concat([\n",
    "                df_positive_upsampled,\n",
    "                df_negative_upsampled,\n",
    "                df_spam_upsampled\n",
    "            ])\n",
    "            \n",
    "        elif strategy == 'downsample':\n",
    "            # Determine target sample size (minimum class size)\n",
    "            target_samples = min(len(df_positive), len(df_negative), len(df_spam))\n",
    "            \n",
    "            # Apply downsampling without replacement\n",
    "            df_positive_downsampled = resample(\n",
    "                df_positive,\n",
    "                replace=False,\n",
    "                n_samples=target_samples,\n",
    "                random_state=self.random_seed\n",
    "            )\n",
    "            \n",
    "            df_negative_downsampled = resample(\n",
    "                df_negative,\n",
    "                replace=False,\n",
    "                n_samples=target_samples,\n",
    "                random_state=self.random_seed\n",
    "            )\n",
    "            \n",
    "            df_spam_downsampled = resample(\n",
    "                df_spam,\n",
    "                replace=False,\n",
    "                n_samples=target_samples,\n",
    "                random_state=self.random_seed\n",
    "            )\n",
    "            \n",
    "            # Combine balanced datasets\n",
    "            self.labeled_data = pd.concat([\n",
    "                df_positive_downsampled,\n",
    "                df_negative_downsampled,\n",
    "                df_spam_downsampled\n",
    "            ])\n",
    "        \n",
    "        else:\n",
    "            raise ValueError(f\"Unknown balancing strategy: {strategy}\")\n",
    "        \n",
    "        # Shuffle the dataset\n",
    "        self.labeled_data = self.labeled_data.sample(\n",
    "            frac=1, \n",
    "            random_state=self.random_seed\n",
    "        ).reset_index(drop=True)\n",
    "        \n",
    "        print(f\"\\n[INFO] Dataset balanced using {strategy} strategy:\")\n",
    "        print(f\"       Target samples per class: {target_samples:,}\")\n",
    "        print(f\"       Total balanced samples: {len(self.labeled_data):,}\")\n",
    "        \n",
    "        # Show final distribution\n",
    "        print(f\"\\n[INFO] Final class distribution:\")\n",
    "        final_counts = self.labeled_data['label'].value_counts()\n",
    "        for label_val in sorted(final_counts.index):\n",
    "            count = final_counts[label_val]\n",
    "            label_name = self.label_map.get(label_val, 'unknown')\n",
    "            percentage = (count / len(self.labeled_data)) * 100\n",
    "            print(f\"       {label_name.capitalize():<12}: {count:>6,} samples ({percentage:5.1f}%)\")\n",
    "        \n",
    "        return self.labeled_data\n",
    "    \n",
    "    def clean_text_column(self) -> pd.DataFrame:\n",
    "        \"\"\"\n",
    "        Clean and preprocess text column.\n",
    "        \"\"\"\n",
    "        def clean_text(text: str) -> str:\n",
    "            \"\"\"Clean individual text entry.\"\"\"\n",
    "            if pd.isna(text):\n",
    "                return \"\"\n",
    "            \n",
    "            text = str(text)\n",
    "            \n",
    "            # Remove URLs\n",
    "            text = re.sub(r'https?://\\S+|www\\.\\S+', '', text)\n",
    "            \n",
    "            # Remove mentions\n",
    "            text = re.sub(r'@\\w+', '', text)\n",
    "            \n",
    "            # Remove excessive whitespace\n",
    "            text = ' '.join(text.split())\n",
    "            \n",
    "            # Remove special characters but keep Indonesian characters\n",
    "            text = re.sub(r'[^\\w\\s\\u00C0-\\u017F]', ' ', text)\n",
    "            \n",
    "            return text.strip()\n",
    "        \n",
    "        if self.labeled_data is not None:\n",
    "            self.labeled_data['cleaned_text'] = self.labeled_data['text'].apply(clean_text)\n",
    "            print(f\"[INFO] Text column cleaned (cleaned_text generated)\")\n",
    "        else:\n",
    "            self.df['cleaned_text'] = self.df['text'].apply(clean_text)\n",
    "            print(f\"[INFO] Text column cleaned (cleaned_text generated)\")\n",
    "        \n",
    "        return self.labeled_data if self.labeled_data is not None else self.df\n",
    "    \n",
    "    def get_dataset_summary(self) -> Dict:\n",
    "        \"\"\"\n",
    "        Generate comprehensive summary statistics for the processed dataset.\n",
    "        \"\"\"\n",
    "        if self.labeled_data is None:\n",
    "            return {}\n",
    "        \n",
    "        summary = {\n",
    "            'total_samples': len(self.labeled_data),\n",
    "            'class_distribution': self.labeled_data['label'].value_counts().to_dict(),\n",
    "            'class_distribution_named': {\n",
    "                self.label_map.get(k, 'unknown'): v \n",
    "                for k, v in self.labeled_data['label'].value_counts().items()\n",
    "            },\n",
    "            'avg_votes': self.labeled_data['votes'].mean(),\n",
    "            'total_hearts': self.labeled_data['heart'].sum(),\n",
    "            'avg_text_length': self.labeled_data['text'].str.len().mean(),\n",
    "            'avg_clean_text_length': self.labeled_data.get('cleaned_text', self.labeled_data['text']).str.len().mean(),\n",
    "            'samples_with_votes': (self.labeled_data['votes'] > 0).sum(),\n",
    "            'samples_with_hearts': (self.labeled_data['heart'] > 0).sum(),\n",
    "        }\n",
    "        \n",
    "        return summary\n",
    "    \n",
    "    def run_pipeline(self, \n",
    "                    balance_strategy: str = 'upsample',\n",
    "                    min_samples: int = None,\n",
    "                    export: bool = True) -> Tuple[pd.DataFrame, Dict]:\n",
    "        \"\"\"\n",
    "        Execute complete preprocessing pipeline.\n",
    "        \"\"\"\n",
    "        print(\"=\" * 60)\n",
    "        print(\"YouTube Comments Preprocessing Pipeline\")\n",
    "        print(\"=\" * 60)\n",
    "        \n",
    "        try:\n",
    "            # Execute pipeline steps\n",
    "            self.load_dataset()\n",
    "            self.filter_columns()\n",
    "            \n",
    "            # Clean votes column\n",
    "            print(\"[INFO] Cleaning vote counts...\")\n",
    "            self.df['votes'] = self.df['votes'].apply(self.clean_vote_count)\n",
    "            \n",
    "            self.standardize_heart_reaction()\n",
    "            self.auto_label_comments(use_existing=False)\n",
    "            self.remove_unlabeled_comments()\n",
    "            self.clean_text_column() # Generates 'cleaned_text'\n",
    "            self.balance_dataset(strategy=balance_strategy, min_samples=min_samples)\n",
    "            \n",
    "            # Generate summary\n",
    "            summary = self.get_dataset_summary()\n",
    "            \n",
    "            print(\"\\n\" + \"=\" * 60)\n",
    "            print(\"Preprocessing Complete ✓\")\n",
    "            print(\"=\" * 60)\n",
    "            \n",
    "            return self.labeled_data, summary\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"\\n[ERROR] Pipeline failed: {str(e)}\")\n",
    "            raise\n"
    "    \n"
    "    def analyze_keyword_effectiveness(self) -> pd.DataFrame:\n",
    "        \"\"\"\n",
    "        Analyze which keywords are most effective for auto-labeling.\n",
    "        \"\"\"\n",
    "        if self.labeled_data is None:\n",
    "            raise ValueError(\"No labeled data available. Run the pipeline first.\")\n",
    "        \n",
    "        keyword_analysis = []\n",
    "        \n",
    "        # Helper to analyze list\n",
    "        def analyze_list(keywords, category_label, category_name):\n",
    "            for keyword in keywords[:50]:\n",
    "                matches = self.labeled_data['text'].str.contains(\n",
    "                    keyword, case=False, na=False\n",
    "                ).sum()\n",
    "                correct_matches = self.labeled_data[\n",
    "                    (self.labeled_data['text'].str.contains(keyword, case=False, na=False)) &\n",
    "                    (self.labeled_data['label'] == category_label)\n",
    "                ].shape[0]\n",
    "                \n",
    "                if matches > 0:\n",
    "                    accuracy = (correct_matches / matches) * 100 if matches > 0 else 0\n",
    "                    keyword_analysis.append({\n",
    "                        'keyword': keyword,\n",
    "                        'category': category_name,\n",
    "                        'matches': matches,\n",
    "                        'correct_matches': correct_matches,\n",
    "                        'accuracy': accuracy\n",
    "                    })\n",
    "        \n",
    "        analyze_list(self.positive_keywords, 1, 'positive')\n",
    "        analyze_list(self.negative_keywords, 0, 'negative')\n",
    "        analyze_list(self.spam_keywords, 2, 'spam')\n",
    "        \n",
    "        analysis_df = pd.DataFrame(keyword_analysis)\n",
    "        if not analysis_df.empty:\n",
    "             analysis_df = analysis_df.sort_values('matches', ascending=False)\n",
    "        \n",
    "        print(\"\\n[INFO] Keyword Effectiveness Analysis:\")\n",
    "        print(f\"       Total keywords analyzed: {len(analysis_df)}\")\n",
    "        \n",
    "        return analysis_df"
   ]
